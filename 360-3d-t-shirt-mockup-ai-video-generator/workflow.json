    {
      "parameters": {
        "jsCode": "const result = {\n  front_image: null,\n  front_image_description: null,\n  back_image: null,\n  back_image_description: null,\n  body_type: null,\n};\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  switch (data.generated_image_side) {\n    case \"front-t-shirt-image\":\n      result.front_image = data.generated_img_url;\n      result.front_image_description = data.image_description;\n      break;\n\n    case \"back-t-shirt-image\":\n      result.back_image = data.generated_img_url;\n      result.back_image_description = data.image_description;\n      break;\n  }\n\n  // Same for all items, so set it once.\n  if (!result.body_type && data.generated_body_type) {\n    result.body_type = data.generated_body_type;\n  }\n}\n\nreturn [\n  {\n    json: result,\n  },\n];"
      },
