    {
      "parameters": {
        "jsCode": "const results = $input.first().json.data.results;\n\nconst titles = [];\n\nfunction extractTitles(value) {\n  if (!value || typeof value !== 'object') return;\n\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      extractTitles(item);\n    }\n    return;\n  }\n\n  // Ignore link elements completely\n  if (value.type === 'link_element') {\n    return;\n  }\n\n  // Only take titles with more than 3 words\n  if (typeof value.title === 'string' && value.title.trim()) {\n    const title = value.title.trim();\n    const wordCount = title.split(/\\s+/).length;\n\n    if (wordCount > 3) {\n      titles.push(title);\n    }\n  }\n\n  for (const key of Object.keys(value)) {\n    extractTitles(value[key]);\n  }\n}\n\nextractTitles(results);\n\n// Remove duplicates\nconst uniqueTitles = [...new Set(titles)];\n\nreturn uniqueTitles.map(title => ({\n  json: {\n    sub_topic: title\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
